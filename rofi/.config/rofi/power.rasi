* {
  background-color: transparent;
  text-color:       #cdd6f4;
  border-color:     rgba(245, 194, 231, 0.8);
  font:             "JetBrainsMono Nerd Font 14";
}

window {
  width:            220px;
  border:           1px;
  border-radius:    12px;
  padding:          10px;
  background-color: rgba(26, 26, 26, 0.95);
}

inputbar { enabled: false; }

listview {
  lines:     3;
  padding:   4px;
  spacing:   4px;
  scrollbar: false;
}

element {
  padding:          12px 16px;
  border-radius:    8px;
  background-color: rgba(245, 194, 231, 0.05);
  text-color:       #bac2de;
}

element selected {
  background-color: rgba(245, 194, 231, 0.2);
  text-color:       #f5c2e7;
  border:           1px;
  border-color:     rgba(245, 194, 231, 0.6);
  border-radius:    8px;
}

element normal {
  background-color: rgba(245, 194, 231, 0.05);
}
