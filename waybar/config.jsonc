{
    "layer": "top",
    "position": "top",
    "height": 22,
    "spacing": 0,

    "modules-left": ["hyprland/workspaces"],
    // "modules-center": ["hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": [ "mpris","pulseaudio","backlight", "power-profiles-daemon", "battery", "tray"],

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "persistent-workspaces": { "*": 9 }
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 80,
        "separate-outputs": true
    },
    "backlight": {
        "format": "{percent}% {icon}",
        "format-icons": ["󰱋", "󰱊", "󱤍"],
    },
    "power-profiles-daemon": {
        "format": " {profile} ",
        "tooltip-format": "Profile: {profile}\nDriver: {driver}",
        "tooltip": true
    },
"mpris": {
    "format": "{player_icon} {dynamic}",
    "format-paused": "{status_icon} {dynamic}",
    "player-icons": { "default": "▶", "spotify": "" },
    "status-icons": { "paused": "⏸" },
    "dynamic-order": ["artist", "title"],
    "dynamic-len": 40,
    "max-length": 50,
    "player": "spotify",
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
},

    "pulseaudio": {
        "format": " vol {volume}% ",
        "format-muted": " muted ",
        "on-click": "pavucontrol",

    },

    "battery": {
        "interval": 1,
        "states": { "warning": 30, "critical": 15 },
        "format": " bat {capacity}% ",
        "format-charging": " {capacity}% 󱐋 ",
        "format-plugged": " plug {capacity}% ",
           "format-full": " full {capacity}% ",
        "tooltip-format": "{timeTo}"
    },

    "clock":  { 
      "format": " {:%a %d %b %H:%M} ",
      "interval": 1,
    },
    "tray":   { "spacing": 8, 
                "icon-size": 16,
                "max-size": 16,
}
        }
