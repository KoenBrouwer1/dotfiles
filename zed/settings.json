// Zed settings


{
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry"
    }
  },
  "edit_predictions": {
    "provider": "zed"
  },
  "cli_default_open_behavior": "existing_window",
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "default_profile": "write",
    "sandbox_permissions": {
      "network_hosts": [
        "apis.justwatch.com",
        "images.justwatch.com",
        "file",
        "example.com"
      ]
    },
    "tool_permissions": {
      "tools": {
        "terminal": {
          "default": "allow"
        },
        "create_directory": {
          "default": "allow"
        }
      }
    },
    "default_model": {
      "provider": "zed.dev",
      "model": "gpt-5.3-codex",
      "enable_thinking": true,
      "effort": "medium"
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "left",
  },
  "disable_ai": false,
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "hover_popover_enabled": false,
  "drag_and_drop_selection": {
    "enabled": true,
  },
  "project_panel": {
    "dock": "right",
  },
  "terminal": {
    "button": false,
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": true,
  },
  "ui_font_family": "JetBrains Mono",
  "buffer_line_height": "comfortable",
  "buffer_font_weight": 500.0,
  "buffer_font_family": "JetBrains Mono",
  "icon_theme": "Material Icon Theme",
  "base_keymap": "VSCode",
  "sticky_scroll": {
    "enabled": false,
  },
  "minimap": {
    "show": "never",
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "auto_indent_on_paste": true,
  "tab_size": 2,
  "ui_font_size": 14.0,
  "buffer_font_size": 13.0,
  "theme": "Nstlgy Dark",
  // "theme": "Catppuccin Mocha",
  "vim_mode": false,
  "tab_bar": {
    "show": false,
  },
  "scrollbar": {
    "show": "never",
  },
  "file_types": {
    "JSON": ["lock"],
  },
}
